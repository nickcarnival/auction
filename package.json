{
  "name": "saas-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "postinstall": "npm run clean:tsbuildinfo",
    "prebuild": "npm install --ignore-scripts --include=dev",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:shared": "npm run build -w shared",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev": "concurrently --names \"CLIENT,SERVER\" \"npm run dev:client\" \"npm run dev:server\"",
    "stripe:sync-webhook-secret": "node scripts/stripe-sync-webhook-secret.js",
    "stripe:webhook": "node scripts/stripe-webhook-forward.mjs",
    "lint": "eslint . --cache --cache-location=node_modules/.cache/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location=node_modules/.cache/.eslintcache",
    "lint:client": "eslint client/src --ext .ts,.tsx --cache --cache-location=node_modules/.cache/.eslintcache-client",
    "lint:server": "eslint server/src --ext .ts --cache --cache-location=node_modules/.cache/.eslintcache-server",
    "lint:shared": "eslint shared/src --ext .ts --cache --cache-location=node_modules/.cache/.eslintcache-shared",
    "lint:client:strict": "eslint client/src --ext .ts,.tsx --max-warnings 0 --cache --cache-location=node_modules/.cache/.eslintcache-client",
    "lint:server:strict": "eslint server/src --ext .ts --max-warnings 0 --cache --cache-location=node_modules/.cache/.eslintcache-server",
    "lint:shared:strict": "eslint shared/src --ext .ts --max-warnings 0 --cache --cache-location=node_modules/.cache/.eslintcache-shared",
    "typecheck": "npm run typecheck:client && npm run typecheck:server && npm run typecheck:shared",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:shared": "tsc -p shared/tsconfig.json --noEmit",
    "typecheck:client:strict": "tsc -p client/tsconfig.json --noEmit --strict --noImplicitAny --strictNullChecks",
    "typecheck:server:strict": "tsc -p server/tsconfig.json --noEmit --strict --noImplicitAny --strictNullChecks",
    "typecheck:shared:strict": "tsc -p shared/tsconfig.json --noEmit --strict --noImplicitAny --strictNullChecks",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss}\"",
    "clean": "npm run clean:client && npm run clean:server && npm run clean:shared && npm run clean:tsbuildinfo",
    "clean:client": "rimraf client/dist",
    "clean:server": "rimraf server/dist",
    "clean:shared": "rimraf shared/dist",
    "clean:tsbuildinfo": "rimraf **/*.tsbuildinfo",
    "check": "npm run typecheck && npm run lint",
    "check:fix": "npm run typecheck && npm run lint:fix",
    "check:strict": "npm run typecheck:server:strict && npm run typecheck:client:strict && npm run lint:server:strict && npm run lint:client:strict",
    "pre-deploy": "npm run check:strict && npm run test && npm run build",
    "test": "npm run test -w shared && npm run test -w server && npm run test -w client",
    "test:server": "npm run test -w server",
    "test:client": "npm run test -w client",
    "test:watch": "npm run test:watch -w server",
    "test:ui": "npm run test:ui -w server",
    "test:coverage": "npm run test:coverage -w server && npm run test:coverage -w client",
    "prepare": "exit 0",
    "start": "npm run start -w server"
  },
  "dependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.25.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-unicorn": "^60.0.0",
    "globals": "^16.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.30.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache"
    ],
    "*.{js,jsx,ts,tsx,json,md,css,scss}": "prettier --write"
  }
}
